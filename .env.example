# Safe to expose in the browser bundle: the anon key is public by design and is
# constrained by Row Level Security. Never put the service_role key or a
# personal access token (sbp_...) in a VITE_ variable - those reach the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
